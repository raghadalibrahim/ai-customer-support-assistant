# ============================================================
# Customer Support Assistant
# Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# Gemini
# ------------------------------------------------------------
# Used by n8n for:
# - Gemini Chat Model
# - Gemini Embeddings
#
# Add the API key through n8n Credentials.
# This variable is provided as a configuration reference only.
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------
# Qdrant
# ------------------------------------------------------------
# Qdrant is used as the vector database for the
# NovaShop knowledge base.
QDRANT_URL=http://localhost:6333

# Collection containing the embedded knowledge base.
QDRANT_COLLECTION=novashop_knowledge


# ------------------------------------------------------------
# n8n
# ------------------------------------------------------------
# Base URL of the local n8n instance.
N8N_URL=http://localhost:5678

# Customer Support Assistant webhook endpoint.
N8N_WEBHOOK_PATH=/webhook/customer-support


# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------
# Used for human-support escalation notifications.
#
# Configure the Telegram Bot credentials inside n8n.
# Do not commit real tokens or chat IDs.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ------------------------------------------------------------
# Knowledge Base
# ------------------------------------------------------------
# Docker-mounted path used by the ingestion workflow.
KNOWLEDGE_BASE_PATH=/data/p5/knowledge


# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------
# Shared Docker network used by n8n and Qdrant.
DOCKER_NETWORK=ai-support-net