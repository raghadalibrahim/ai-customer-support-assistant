    {
      "parameters": {
        "promptType": "define",
        "text": "=Question:\n{{ $json.question }}\n\nRetrieved Knowledge:\n{{ JSON.stringify($json.retrieved_documents) }}",
        "options": {
          "systemPromptTemplate": "You are the NovaShop customer support assistant.\n\nAnswer the customer's question using only the retrieved context.\n\nDo not use general knowledge, assumptions, or information not present in the retrieved context.\n\nIf the retrieved context does not contain enough information to answer the question, say:\n\"I don't have enough information in the available knowledge base to answer this question.\"\n\nNever invent policies, prices, product specifications, availability, shipping dates, refund decisions, or warranty coverage.\n\nThe AI assistant must not approve, promise, or initiate refunds.\n\nSensitive cases such as fraud, unauthorized transactions, account compromise, security incidents, disputed charges, or requests for exceptions must be escalated to a human support agent.\n\nRetrieved context:\n{context}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainRetrievalQa",
      "typeVersion": 1.7,
      "position": [
        0,
        -352
      ],
      "id": "fd4e01e7-ccc1-4760-b87f-86c4aea6ca28",
      "name": "Question and Answer Chain"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        96,
        64
      ],
      "id": "7572a27a-ea10-4678-88d7-842f88774dfe",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst question = $('Edit Fields').first().json.question;\n\nconst sources = items.map(item => {\n  const doc = item.json.document;\n\n  return {\n    source: doc?.metadata?.source ?? \"unknown\",\n    content: doc?.pageContent ?? \"\",\n    score: typeof item.json.score === \"number\"\n      ? item.json.score\n      : null,\n    document: doc ?? null\n  };\n});\n\nlet conflict = false;\n\nconst isHoursQuestion =\n  /support hours|customer support hours|opening hours|working hours|when.*support.*available/i.test(question);\n\nif (isHoursQuestion) {\n  const company = sources.find(x => x.source === \"company.md\");\n  const faq = sources.find(x => x.source === \"faq.md\");\n\n  if (company && faq) {\n    const extractHours = (text) => {\n      const match = text.match(\n        /Monday to Friday from\\s+(\\d{2}:\\d{2})\\s+to\\s+(\\d{2}:\\d{2})/i\n      );\n\n      return match ? `${match[1]}-${match[2]}` : null;\n    };\n\n    const companyHours = extractHours(company.content);\n    const faqHours = extractHours(faq.content);\n\n    if (\n      companyHours &&\n      faqHours &&\n      companyHours !== faqHours\n    ) {\n      conflict = true;\n    }\n  }\n}\n\nconst validScores = sources\n  .map(x => x.score)\n  .filter(score => typeof score === \"number\");\n\nconst topScore = validScores.length\n  ? Math.max(...validScores)\n  : 0;\n\nconst confidence = Number(\n  Math.min(topScore / 0.75, 1).toFixed(2)\n);\n\nreturn [\n  {\n    json: {\n      question,\n      conflict_detected: conflict,\n      confidence,\n      top_retrieval_score: topScore,\n      sources_found: sources.map(x => x.source),\n      retrieved_documents: sources.map(x => x.document)\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        -368
      ],
      "id": "bdb883a1-a7c0-4eb0-962f-d3cf9ef7258c",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
