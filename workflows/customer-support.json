    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst sources = item.sources_found ?? [];\n\nreturn [\n  {\n    json: {\n      status: \"escalated\",\n      reason: \"Conflicting knowledge base information\",\n      priority: \"high\",\n      customer_question: $('Edit Fields').first().json.question,\n      conflict_detected: item.conflict_detected === true,\n      conflicting_sources: sources.filter(\n        source => source === \"company.md\" || source === \"faq.md\"\n      ),\n      message_to_agent:\n        \"The knowledge base contains conflicting information about customer support hours. Human review is required before responding to the customer.\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
