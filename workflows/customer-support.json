    {
      "parameters": {
        "jsCode": "const response = $json.response ?? \"\";\nconst retrieval = $('Code in JavaScript').first().json;\n\nconst question = retrieval.question ?? \"\";\n\nconst insufficient =\n  response.toLowerCase().includes(\n    \"i don't have enough information\"\n  );\n\nconst requiresHumanByRule =\n  /unauthorized|not authorized|account compromise|compromised account|someone accessed|fraud|duplicate charge|charged twice|disputed charge|payment dispute|security incident/i\n    .test(question);\n\nconst requiresHuman =\n  insufficient || requiresHumanByRule;\n\nreturn [\n  {\n    json: {\n      response,\n      status: insufficient\n        ? \"insufficient_knowledge\"\n        : requiresHumanByRule\n          ? \"human_escalation_required\"\n          : \"resolved\",\n      requires_human: requiresHuman,\n      confidence: insufficient\n        ? 0\n        : retrieval.confidence,\n      top_retrieval_score: retrieval.top_retrieval_score\n    }\n  }\n];"
      },
